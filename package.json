{
  "name": "Wedding-Invitation",
  "version": "1.0.0",
  "private": true,
  "description": "A wedding invitation website built with React and deployed on Cloudflare Workers",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --serve",
    "cf-dev": "node build.js && npx wrangler dev --port 8788",
    "deploy": "node build.js && npx wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  }
}
